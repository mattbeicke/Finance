<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mattb.controller.MainController"
            prefHeight="750.0" prefWidth="1500.0">
    <children>
        <BorderPane prefHeight="750.0" prefWidth="1500.0" fx:id="mainBorderPane">
            <left>
                <VBox prefHeight="750.0" prefWidth="100.0" BorderPane.alignment="CENTER">
                    <children>
                        <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" text="Dashboard" onAction="#showDashboard"/>
                        <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" text="Transactions" onAction="#showTransactions"/>
                        <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" text="Accounts" onAction="#showAccounts"/>
                    </children>
                </VBox>
            </left>
        </BorderPane>
    </children>
</AnchorPane>

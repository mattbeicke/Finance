<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mattb.controller.AccountController"
            prefHeight="750.0" prefWidth="1500.0">
    <VBox BorderPane.alignment="CENTER">
        <HBox>
            <Button fx:id="addAccount" onAction="#addNewAccount">Add New Account</Button>
            <Button fx:id="addType" onAction="#addNewType">Add New Type</Button>
            <Button fx:id="hideAccount" onAction="#hideAccount">Hide Account</Button>
            <Button fx:id="viewHidden" onAction="#viewHidden">View Hidden</Button>
            <Button onAction="#editSelected">Edit Selected</Button>
        </HBox>

        <TableView prefHeight="750.0" prefWidth="1400.0" fx:id="accountTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>

            <columns>
                <TableColumn text="Name" fx:id="colName"/>
                <TableColumn text="Type" fx:id="colType"/>
                <TableColumn text="Balance" fx:id="colBalance"/>
            </columns>
        </TableView>

        <HBox>
            <Button fx:id="left" text="<" onAction="#leftPage"/>
            <Button fx:id="right" text=">" onAction="#rightPage"/>
        </HBox>
    </VBox>
</AnchorPane>

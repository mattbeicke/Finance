<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mattb.controllers.AddAccountController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox alignment="CENTER" spacing="10.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <Label text="Account Name (must be unique):"/>
        <TextField fx:id="nameField"/>

        <HBox alignment="CENTER" spacing="10.0">
            <Label text="Account Type"/>
            <ComboBox fx:id="typeCombo"/>
        </HBox>

        <Label text="Initial Balance:"/>
        <TextField fx:id="balanceField"/>

        <HBox alignment="CENTER" spacing="10.0">
            <Button prefHeight="26.0" prefWidth="52.0" text="Save" onAction="#onAccountSave"/>
            <Button prefHeight="26.0" prefWidth="52.0" text="Cancel" onAction="#cancel"/>
        </HBox>
    </VBox>
</AnchorPane>

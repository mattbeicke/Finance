<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mattb.controllers.AddTransactionController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox alignment="CENTER" spacing="10.0"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <HBox alignment="CENTER" spacing="10.0">
            <Label text="From"/>
            <ComboBox fx:id="fromCombo"/>
        </HBox>

        <HBox alignment="CENTER" spacing="15.0">
            <Label text="To"/>
            <ComboBox fx:id="toCombo"/>
        </HBox>

        <Label text="Category (comma separated):"/>
        <TextField fx:id="categoryField"/>

        <Label text="Amount:"/>
        <TextField fx:id="amountField"/>

        <Label text="Memo:"/>
        <TextField fx:id="memoField"/>

        <Label text="Date of transaction"/>
        <DatePicker fx:id="datePicker"/>

        <HBox alignment="CENTER" spacing="10.0">
            <Button prefHeight="26.0" prefWidth="52.0" text="Save" onAction="#onSave"/>
            <Button prefHeight="26.0" prefWidth="52.0" text="Cancel" onAction="#cancel"/>
        </HBox>
    </VBox>
</AnchorPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="mattb.controllers.MainController"
            prefHeight="750.0" prefWidth="1500.0">
    <BorderPane prefHeight="750.0" prefWidth="1500.0" fx:id="mainBorderPane">
        <left>
            <VBox prefHeight="750.0" prefWidth="100.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="2" right="10" left="2"/>
                </padding>

                <Button alignment="CENTER" maxWidth="Infinity" contentDisplay="CENTER" mnemonicParsing="false"
                        text="Dashboard" onAction="#showDashboard"/>
                <Button alignment="CENTER" maxWidth="Infinity" contentDisplay="CENTER" mnemonicParsing="false"
                        text="Transactions" onAction="#showTransactions"/>
                <Button alignment="CENTER" maxWidth="Infinity" contentDisplay="CENTER" mnemonicParsing="false"
                        text="Accounts" onAction="#showAccounts"/>
            </VBox>
        </left>
    </BorderPane>
</AnchorPane>

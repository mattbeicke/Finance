<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="750.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="mattb.controller.TransactionController">
    <VBox BorderPane.alignment="CENTER">
        <Button alignment="CENTER" onAction="#addNew">Add New</Button>
        <TableView prefHeight="750.0" prefWidth="1400.0" fx:id="transactionTable">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn text="Date" fx:id="colDate"/>
                <TableColumn text="From Account" fx:id="colFrom"/>
                <TableColumn text="To Account" fx:id="colTo"/>
                <TableColumn text="Category" fx:id="colCategory"/>
                <TableColumn text="Amount" fx:id="colAmount"/>
                <TableColumn text="Memo" fx:id="colMemo"/>
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
